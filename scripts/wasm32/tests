#!/bin/bash
set -e

# Process args, extracting --relaxed if present
ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--relaxed" ]]; then
        export RELAXED_WARNINGS=1
    else
        ARGS+=("$arg")
    fi
done

source "$(dirname "$0")/_env"

CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="wasm-bindgen-test-runner" RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo +nightly test --target=wasm32-unknown-unknown "${ARGS[@]}"
